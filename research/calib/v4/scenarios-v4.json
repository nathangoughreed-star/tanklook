  "scenarios": [
    { "id": "A01", "module": "A", "tank": "g5", "env": { "water": "fresh", "tempC": 26 },
      "stock": [ { "id": "betta", "n": 1, "sex": "m" } ],
      "ask": ["verdict", "change", "min", "confidence"],
      "min": { "species": "betta", "sizes": ["2.5 gal (12 x 6 x 8 in)", "5 gal (16 x 8 x 10 in)", "10 gal (20 x 10 x 12 in)", "20 gal long (30 x 12 x 12 in)"] },
      "tests": ["tankmin.betta", "space.nano"], "why": "The most common tank in the hobby. The app's betta minimum is a 16 x 8 in footprint (red) and 18 x 12 (green)." },
    { "id": "A02", "module": "A", "tank": "g10", "env": { "water": "fresh", "tempC": 25 },
      "stock": [ { "id": "betta", "n": 1, "sex": "m" }, { "id": "neon", "n": 6 }, { "id": "nerite", "n": 2 } ],
      "focal": "neon", "ask": ["verdict", "change", "compat", "counts", "confidence"],
      "tests": ["compat.temperature-narrow", "compat.temper-vs-school", "space.nano"], "why": "Betta plus a small school in a 10: the app finds only a narrow shared temperature (betta 24-29, neon 21-25) and no other problem." },
    { "id": "A03", "module": "A", "tank": "g10", "env": { "water": "fresh", "tempC": 25, "planted": true },
      "stock": [ { "id": "guppy", "n": 8, "sex": [2, 6] }, { "id": "cherryshrimp", "n": 6 }, { "id": "nerite", "n": 1 } ],
      "focal": "guppy", "ask": ["verdict", "change", "counts", "compat", "confidence"],
      "tests": ["space.livebearer-nano", "compat.prey-shrimp", "groups.sexed"], "why": "Guppies with shrimp: the app has no guppy predation rule, so it passes the pair. Breeding is not counted; judge the adults as listed." },
    { "id": "A04", "module": "A", "tank": "g20l", "env": { "water": "fresh", "tempC": 24 },
      "stock": [ { "id": "neon", "n": 10 }, { "id": "bronzecory", "n": 6 }, { "id": "bristlenose", "n": 1 } ],
      "focal": "neon", "ask": ["verdict", "change", "counts", "confidence"],
      "tests": ["space.water", "space.floor", "space.canonical-20"], "why": "The textbook 20 long. A clean read of both dimensions at counts people really keep." },
    { "id": "A05", "module": "A", "tank": "g20h", "env": { "water": "fresh", "tempC": 24 },
      "stock": [ { "id": "neon", "n": 10 }, { "id": "bronzecory", "n": 6 }, { "id": "bristlenose", "n": 1 } ],
      "focal": "neon", "ask": ["verdict", "counts", "confidence"], "pairOf": "A04",
      "tests": ["space.footprint-vs-height"], "why": "The same stock in a 20 high (24 x 12 footprint instead of 30 x 12). Tests the height curve and the floor share against the long tank." },
    { "id": "A06", "module": "A", "tank": "g29", "env": { "water": "fresh", "tempC": 25, "planted": true },
      "stock": [ { "id": "harlequin", "n": 12 }, { "id": "pandacory", "n": 8 }, { "id": "dwarfgourami", "n": 1, "sex": "m" }, { "id": "amano", "n": 3 }, { "id": "nerite", "n": 2 } ],
      "focal": "harlequin", "ask": ["verdict", "change", "counts", "compat", "confidence"],
      "tests": ["space.community-29", "compat.temperature-narrow"], "why": "A standard 29 community. Panda corys (21-25) and a dwarf gourami (24-28) share only 24-25 in the app's bands." },
    { "id": "A07", "module": "A", "tank": "g29", "env": { "water": "fresh", "tempC": 25 },
      "stock": [ { "id": "tigerbarb", "n": 8 }, { "id": "betta", "n": 1, "sex": "m" } ],
      "ask": ["verdict", "change", "compat", "confidence"],
      "tests": ["compat.nip-vs-fins"], "why": "Fin nippers with a long-finned fish: the app blocks this pair. A check that the gate matches the experts and that the reason category is read the same way." },
    { "id": "A08", "module": "A", "tank": "g40b", "env": { "water": "fresh", "tempC": 26 },
      "stock": [ { "id": "angel", "n": 2, "note": "a bonded pair" }, { "id": "rummynose", "n": 15 }, { "id": "sterbai", "n": 10 }, { "id": "bristlenose", "n": 2, "sex": [1, 1] } ],
      "focal": "rummynose", "ask": ["verdict", "change", "counts", "min", "compat", "confidence"],
      "min": { "species": "angel", "sizes": ["29 gal (30 x 12 x 18 in)", "40 gal breeder (36 x 18 x 16 in)", "55 gal (48 x 13 x 21 in)", "75 gal (48 x 18 x 21 in)"] },
      "tests": ["tankmin.angel-height", "compat.breeding-pair-floor", "compat.prey-size"], "why": "Angels in a 16 in tall tank (the app wants 20 in of height for adults), a pair's guarded floor (2400 sq cm each against a 36 x 18 floor), rummy-noses just above the angel's prey size." },
    { "id": "A09", "module": "A", "tank": "g55", "env": { "water": "fresh", "tempC": 26 },
      "stock": [ { "id": "angel", "n": 2, "note": "a bonded pair" }, { "id": "neon", "n": 12 }, { "id": "bronzecory", "n": 8 } ],
      "ask": ["verdict", "change", "compat", "confidence"],
      "tests": ["compat.prey-size"], "why": "The classic question. The app's angel eats fish up to 30 mm; a neon is 38 mm, so the app passes it. Experts often do not." },
    { "id": "A10", "module": "A", "tank": "g55", "env": { "water": "fresh", "tempC": 25 },
      "stock": [ { "id": "neon", "n": 20 }, { "id": "cardinal", "n": 10 }, { "id": "rummynose", "n": 8 }, { "id": "bronzecory", "n": 12 }, { "id": "oto", "n": 6 }, { "id": "bristlenose", "n": 1 }, { "id": "gourami", "n": 2, "sex": [1, 1] } ],
      "focal": "neon", "ask": ["verdict", "change", "counts", "confidence"],
      "tests": ["space.school-curve", "space.full-community"], "why": "A full 55 with three schools. Tests how the app adds schools (the 0.72 exponent) and where the whole reads against the experts' sense of full." },
    { "id": "A11", "module": "A", "tank": "g75", "env": { "water": "fresh", "tempC": 26 },
      "stock": [ { "id": "boesemani", "n": 8, "sex": [3, 5] }, { "id": "cherrybarb", "n": 12, "sex": [4, 8] }, { "id": "kuhli", "n": 10 }, { "id": "sae", "n": 4 } ],
      "focal": "boesemani", "ask": ["verdict", "change", "counts", "confidence"],
      "tests": ["space.mid-class", "space.kuhli-floor-factor", "groups.sae"], "why": "Mid-size active fish: the mid class has few clean answers so far. Kuhlis carry a hand-set floor factor (0.6)." },
    { "id": "A12", "module": "A", "tank": "g20l", "env": { "water": "fresh", "tempC": 20, "note": "unheated room-temperature tank" },
      "stock": [ { "id": "danio", "n": 12 }, { "id": "whitecloud", "n": 8 } ],
      "focal": "danio", "ask": ["verdict", "change", "counts", "confidence"],
      "tests": ["space.coolwater", "compat.nip-no-target"], "why": "A coolwater tank. Danios nip, but nothing here has long fins, so the app says nothing: a check that it stays quiet when it should." },
    { "id": "A13", "module": "A", "tank": "g10", "env": { "water": "fresh", "tempC": 24 },
      "stock": [ { "id": "neon", "n": 20 } ],
      "focal": "neon", "ask": ["verdict", "change", "counts", "confidence"],
      "tests": ["space.water-small", "space.school-curve"], "why": "The overstocked-10 question everyone asks. One species, so the ideal and at-most counts fall straight onto the water scale and the school curve." },
    { "id": "A14", "module": "A", "tank": "g29", "env": { "water": "fresh", "tempC": 26, "planted": true },
      "stock": [ { "id": "betta", "n": 1, "sex": "m" }, { "id": "ember", "n": 10 }, { "id": "pygmycory", "n": 8 }, { "id": "kuhli", "n": 6 } ],
      "focal": "ember", "ask": ["verdict", "change", "compat", "counts", "confidence"],
      "tests": ["compat.betta-community", "space.tiny-class"], "why": "A betta community done the usual way (small, quick, not colourful tankmates). The app has no rule against it. Embers are a tiny-class fish (now 23 mm after the length audit)." },
    { "id": "A15", "module": "A", "tank": "g20l", "env": { "water": "fresh", "tempC": 25, "planted": true },
      "stock": [ { "id": "honeygourami", "n": 3, "sex": [1, 2] }, { "id": "chili", "n": 12 }, { "id": "cherryshrimp", "n": 15 } ],
      "focal": "chili", "ask": ["verdict", "change", "counts", "compat", "confidence"],
      "tests": ["space.chili-refit", "compat.prey-shrimp", "space.invert-class"], "why": "Nano fish after the length audit (chili 35 -> 23 mm, its space factor refitted). Shrimp with small gouramis: no rule in the app." },
    { "id": "A16", "module": "A", "tank": "g40b", "env": { "water": "fresh", "tempC": 25 },
      "stock": [ { "id": "platy", "n": 6, "sex": [2, 4] }, { "id": "molly", "n": 6, "sex": [2, 4] }, { "id": "swordtail", "n": 5, "sex": [1, 4] }, { "id": "bronzecory", "n": 8 } ],
      "focal": "platy", "ask": ["verdict", "change", "counts", "confidence"],
      "tests": ["space.livebearers", "groups.sexed", "space.swordtail-refit"], "why": "A livebearer tank. Swordtail length was cut in the audit (140/160 -> 110/120 mm) and its factor refitted; three sexed groups in one tank." },

    { "id": "B01", "module": "B", "tank": "g55", "env": { "water": "fresh", "tempC": 25 },
      "stock": [ { "id": "oscar", "n": 1 } ],
      "ask": ["verdict", "change", "min", "confidence"],
      "min": { "species": "oscar", "sizes": ["55 gal (48 x 13 x 21 in)", "75 gal (48 x 18 x 21 in)", "125 gal (72 x 18 x 21 in)", "180 gal (72 x 24 x 24 in)"] },
      "tests": ["tankmin.oscar"], "why": "The app's oscar minimum is a 59 x 24 in footprint, which rules out the 55 and the 75. The hobby argues this one." },
    { "id": "B02", "module": "B", "tank": "g125", "env": { "water": "fresh", "tempC": 26 },
      "stock": [ { "id": "oscar", "n": 1 }, { "id": "clownloach", "n": 5, "note": "adults, about 23 cm" }, { "id": "bristlenose", "n": 1 } ],
      "focal": "clownloach", "ask": ["verdict", "change", "counts", "compat", "confidence"],
      "tests": ["space.big-class", "tankmin.clownloach", "compat.prey-size"], "why": "Big fish in a big tank: the big class is calibrated on few lists. The oscar eats fish to 100 mm; both tankmates are above that in the app." },
    { "id": "B03", "module": "B", "tank": "g10", "env": { "water": "fresh", "tempC": 21, "note": "unheated" },
      "stock": [ { "id": "goldfish", "n": 1 } ],
      "ask": ["verdict", "change", "min", "confidence"],
      "min": { "species": "goldfish", "sizes": ["10 gal (20 x 10 x 12 in)", "20 gal high (24 x 12 x 16 in)", "29 gal (30 x 12 x 18 in)", "40 gal breeder (36 x 18 x 16 in)"] },
      "tests": ["tankmin.goldfish"], "why": "The app's fancy goldfish minimum is 30 x 13 in and 20 gal. A near-universal beginner question." },
    { "id": "B04", "module": "B", "tank": "g40b", "env": { "water": "fresh", "tempC": 21, "note": "unheated" },
      "stock": [ { "id": "goldfish", "n": 3 }, { "id": "whitecloud", "n": 6 } ],
      "focal": "goldfish", "ask": ["verdict", "change", "counts", "compat", "confidence"],
      "tests": ["space.big-class-mass", "compat.coolwater-mates"], "why": "Fancy goldfish are heavy for their length; the app counts mass. White clouds are the usual coolwater companion and the app has no rule either way." },
    { "id": "B05", "module": "B", "tank": "g55", "env": { "water": "fresh", "tempC": 29 },
      "stock": [ { "id": "discus", "n": 6, "note": "adults" } ],
      "focal": "discus", "ask": ["verdict", "change", "counts", "confidence"],
      "tests": ["golden.discus-85"], "why": "Nathan's golden: 6 discus in a 55 are set to read 85 % (caution). The experts' ideal and at-most counts say whether that target holds." },
    { "id": "B06", "module": "B", "tank": "g75", "env": { "water": "fresh", "tempC": 29 },
      "stock": [ { "id": "discus", "n": 6, "note": "adults" }, { "id": "cardinal", "n": 15 }, { "id": "sterbai", "n": 8 } ],
      "focal": "discus", "ask": ["verdict", "change", "counts", "compat", "confidence"],
      "tests": ["space.discus-community", "compat.temperature-warm"], "why": "The classic discus community at 29 C: cardinals (23-29) and sterbai (24-28) sit at the top of their bands." },
    { "id": "B07", "module": "B", "tank": "g55", "env": { "water": "fresh", "tempC": 26, "note": "hard alkaline water, heavy rockwork" },
      "stock": [ { "id": "yellowlab", "n": 8, "sex": [2, 6] }, { "id": "demasoni", "n": 8, "sex": [2, 6] } ],
      "focal": "yellowlab", "ask": ["verdict", "change", "counts", "max", "compat", "confidence"],
      "max": [ { "species": "demasoni", "options": ["0", "4", "6", "8", "12", "16+"] } ],
      "tests": ["space.mbuna-convention", "tankmin.demasoni-width", "groups.demasoni"], "why": "Mbuna keepers overstock on purpose to spread aggression; the app's space scale does not know that. Demasoni want 47 x 18 in the app (the 55 is 13 in wide) and a group of 12+." },
    { "id": "B08", "module": "B", "tank": "g75", "env": { "water": "fresh", "tempC": 26, "note": "hard alkaline water" },
      "stock": [ { "id": "peacock", "n": 5, "sex": [1, 4] }, { "id": "yellowlab", "n": 6, "sex": [1, 5] }, { "id": "syno", "n": 3 } ],
      "focal": "peacock", "ask": ["verdict", "change", "counts", "confidence"],
      "tests": ["space.malawi-mix", "groups.syno"], "why": "Peacocks with labs and synodontis: the usual Malawi 75. Mid and big class fish at realistic counts." },
    { "id": "B09", "module": "B", "tank": "g29", "env": { "water": "fresh", "tempC": 25 },
      "stock": [ { "id": "neon", "n": 8 }, { "id": "yellowlab", "n": 2, "sex": [1, 1] }, { "id": "bronzecory", "n": 6 } ],
      "ask": ["verdict", "change", "compat", "confidence"],
      "tests": ["compat.water-chemistry", "compat.temper", "tankmin.yellowlab", "groups.yellowlab-min"], "why": "A Malawi cichlid in a soft-water community: the app flags pH and hardness, the lab's 35 x 18 minimum and its group of 4." },
    { "id": "B10", "module": "B", "tank": "g20l", "env": { "water": "fresh", "tempC": 24, "note": "caves provided" },
      "stock": [ { "id": "kribensis", "n": 2, "sex": [1, 1], "note": "a pair" }, { "id": "neon", "n": 8 }, { "id": "pandacory", "n": 6 } ],
      "ask": ["verdict", "change", "compat", "confidence"],
      "tests": ["compat.breeding-pair-floor", "compat.cover-cave"], "why": "A krib pair guards about 1800 sq cm in the app; a 20 long has 2300, so the corys share a guarded floor. The app says concern, not block." },
    { "id": "B11", "module": "B", "tank": "g20h", "env": { "water": "fresh", "tempC": 28 },
      "stock": [ { "id": "gbr", "n": 2, "sex": [1, 1], "note": "a pair" }, { "id": "ember", "n": 10 }, { "id": "cherryshrimp", "n": 10 } ],
      "ask": ["verdict", "change", "compat", "confidence"],
      "tests": ["compat.temperature-none", "compat.prey-shrimp"], "why": "Rams want 27-30, embers 23-27: one shared degree. Rams eat shrimp to 30 mm in the app (blocking). Two different reasons in one tank." },
    { "id": "B12", "module": "B", "tank": "g29", "env": { "water": "fresh", "tempC": 25, "planted": true },
      "stock": [ { "id": "dwarfgourami", "n": 2, "sex": "m", "note": "both males" }, { "id": "harlequin", "n": 10 }, { "id": "pandacory", "n": 6 } ],
      "ask": ["verdict", "change", "maxMales", "compat", "confidence"],
      "maxMales": [ { "species": "dwarfgourami", "options": ["0", "1", "2", "3"] } ],
      "tests": ["groups.males-rule", "compat.temperature-narrow"], "why": "The app allows a second male dwarf gourami from 25 gal (one at 10, one more per 15). Most keepers say one male per tank." },
    { "id": "B13", "module": "B", "tank": "g10", "env": { "water": "fresh", "tempC": 26, "planted": true, "note": "densely planted" },
      "stock": [ { "id": "peapuffer", "n": 3, "sex": [1, 2] }, { "id": "oto", "n": 6 } ],
      "ask": ["verdict", "change", "max", "compat", "confidence"],
      "max": [ { "species": "peapuffer", "options": ["0", "1", "2", "3", "4", "5+"] } ],
      "tests": ["groups.territory-puffer", "compat.species-only"], "why": "Pea puffers: one per 5 gal plus one per 3 in the app; it also flags any tankmate. Otos are the tankmate keepers most often allow." },
    { "id": "B14", "module": "B", "tank": "g40b", "env": { "water": "fresh", "tempC": 25 },
      "stock": [ { "id": "bolivianram", "n": 4, "sex": [2, 2] }, { "id": "rummynose", "n": 12 }, { "id": "sterbai", "n": 8 } ],
      "ask": ["verdict", "change", "max", "confidence"],
      "max": [ { "species": "bolivianram", "options": ["1", "2", "3", "4", "6", "8+"] } ],
      "tests": ["groups.territory-bolivian", "compat.breeding-pair-floor"], "why": "Bolivian rams: one at 30 gal plus one per 7.5 gal in the app, so two in a 40 breeder. Four is what shops sell." },
    { "id": "B15", "module": "B", "tank": "g20l", "env": { "water": "fresh", "tempC": 24, "note": "new tank: cycled six weeks ago, no visible algae yet" },
      "stock": [ { "id": "bristlenose", "n": 1 }, { "id": "oto", "n": 8 }, { "id": "amano", "n": 6 } ],
      "focal": "oto", "ask": ["verdict", "change", "counts", "confidence"],
      "tests": ["limits.food-not-room", "groups.grazer-density"], "why": "Grazers in a tank with nothing to graze. The app's grazer rule (6 otos per 20 gal unless fed) is a non-room limit; a test that experts and the app both call it that." },
    { "id": "B16", "module": "B", "tank": "g10", "env": { "water": "fresh", "tempC": 23, "planted": true },
      "stock": [ { "id": "cherryshrimp", "n": 30 }, { "id": "nerite", "n": 3 }, { "id": "chili", "n": 8 } ],
      "focal": "cherryshrimp", "ask": ["verdict", "change", "counts", "confidence"],
      "tests": ["space.invert-class", "compat.fish-in-shrimp-tank"], "why": "A shrimp tank with a few nano fish. The invert class (0.48) has one real answer so far; shrimp counts may be answered as can't say, which is itself a finding." },

    { "id": "C01", "module": "C", "tank": "g10", "env": { "water": "salt", "tempC": 25, "note": "live rock, no corals" },
      "stock": [ { "id": "ocellaris", "n": 2, "note": "a bonded pair" }, { "id": "hermit", "n": 2 } ],
      "ask": ["verdict", "change", "min", "confidence"],
      "min": { "species": "ocellaris", "sizes": ["10 gal (20 x 10 x 12 in)", "15 gal (24 x 12 x 12 in)", "20 gal (24 x 12 x 16 in)", "29 gal (30 x 12 x 18 in)"] },
      "tests": ["tankmin.ocellaris", "space.salt-load"], "why": "The first saltwater tank most people set up. The app wants 24 x 12 in and counts marine fish at 1.5x the load." },
    { "id": "C02", "module": "C", "tank": "aio20", "env": { "water": "salt", "tempC": 25, "note": "soft corals, live rock" },
      "stock": [ { "id": "ocellaris", "n": 2, "note": "a pair" }, { "id": "royalgramma", "n": 1 }, { "id": "firefish", "n": 1 }, { "id": "cleanershrimp", "n": 2 }, { "id": "hermit", "n": 5 }, { "id": "turbo", "n": 3 } ],
      "ask": ["verdict", "change", "min", "compat", "confidence"],
      "min": { "species": "royalgramma", "sizes": ["20 gal cube (18 x 18 x 16 in)", "29 gal (30 x 12 x 18 in)", "40 gal breeder (36 x 18 x 16 in)", "55 gal (48 x 13 x 21 in)"] },
      "tests": ["space.nano-reef", "tankmin.royalgramma"], "why": "The standard nano reef list. The app's royal gramma minimum is 36 x 18 in, which no nano meets; is that right?" },
    { "id": "C03", "module": "C", "tank": "aio29", "env": { "water": "salt", "tempC": 25, "note": "LPS corals, live rock" },
      "stock": [ { "id": "ocellaris", "n": 2, "note": "a pair" }, { "id": "watchman", "n": 1 }, { "id": "sixline", "n": 1 }, { "id": "cleanershrimp", "n": 1 }, { "id": "hermit", "n": 10 }, { "id": "turbo", "n": 5 } ],
      "focal": "hermit", "ask": ["verdict", "change", "compat", "counts", "confidence"],
      "tests": ["compat.prey-sw-inverts", "compat.hermits-vs-snails", "tankmin.sixline"], "why": "Two invert questions the app answers by size only: a six-line (eats inverts to 30 mm) with a 60 mm cleaner shrimp, hermits (to 50 mm) with 70 mm turbos. Keepers know hermits kill snails for shells." },
    { "id": "C04", "module": "C", "tank": "g40b", "env": { "water": "salt", "tempC": 25, "note": "LPS and soft corals" },
      "stock": [ { "id": "ocellaris", "n": 2, "note": "a pair" }, { "id": "royalgramma", "n": 1 }, { "id": "chromis", "n": 6 }, { "id": "coralbeauty", "n": 1 }, { "id": "watchman", "n": 1 }, { "id": "cleanershrimp", "n": 1 }, { "id": "hermit", "n": 10 }, { "id": "turbo", "n": 5 } ],
      "focal": "chromis", "ask": ["verdict", "change", "counts", "compat", "confidence"],
      "tests": ["space.reef-40", "compat.coral-nipper", "tankmin.coralbeauty", "groups.chromis"], "why": "A full 40 breeder reef. The coral beauty may nip corals (the app says caution in a reef) and wants 48 x 18 in; six chromis is the app's minimum group." },
    { "id": "C05", "module": "C", "tank": "g55", "env": { "water": "salt", "tempC": 25, "note": "LPS and soft corals" },
      "stock": [ { "id": "ocellaris", "n": 2, "note": "a pair" }, { "id": "royalgramma", "n": 1 }, { "id": "chromis", "n": 6 }, { "id": "coralbeauty", "n": 1 }, { "id": "watchman", "n": 1 }, { "id": "cleanershrimp", "n": 1 }, { "id": "hermit", "n": 10 }, { "id": "turbo", "n": 5 } ],
      "focal": "chromis", "ask": ["verdict", "counts", "confidence"], "pairOf": "C04",
      "tests": ["space.salt-scale", "tankmin.coralbeauty-width"], "why": "The same reef in a 55 (48 x 13 x 21): more water, a narrower floor. Reads the salt scale against volume and the width minimum." },
    { "id": "C06", "module": "C", "tank": "g55", "env": { "water": "salt", "tempC": 25, "note": "fish only with live rock" },
      "stock": [ { "id": "yellowtang", "n": 1 }, { "id": "ocellaris", "n": 2, "note": "a pair" }, { "id": "chromis", "n": 6 }, { "id": "firefish", "n": 1 } ],
      "ask": ["verdict", "change", "min", "confidence"],
      "min": { "species": "yellowtang", "sizes": ["55 gal (48 x 13 x 21 in)", "75 gal (48 x 18 x 21 in)", "90 gal (48 x 18 x 24 in)", "125 gal (72 x 18 x 21 in)"] },
      "tests": ["tankmin.yellowtang"], "why": "The app's yellow tang minimum is 48 x 18 in and 90 gal: the 55 fails on width and volume. The hobby puts tangs in 55s all the time." },
    { "id": "C07", "module": "C", "tank": "g75", "env": { "water": "salt", "tempC": 25, "note": "live rock, soft corals" },
      "stock": [ { "id": "yellowtang", "n": 1 }, { "id": "bluetang", "n": 1, "note": "juvenile now, judge for the adult" }, { "id": "ocellaris", "n": 2, "note": "a pair" }, { "id": "royalgramma", "n": 1 }, { "id": "chromis", "n": 5 } ],
      "ask": ["verdict", "change", "compat", "min", "confidence"],
      "min": { "species": "bluetang", "sizes": ["75 gal (48 x 18 x 21 in)", "125 gal (72 x 18 x 21 in)", "180 gal (72 x 24 x 24 in)", "240 gal (96 x 24 x 24 in)"] },
      "tests": ["compat.two-tangs", "tankmin.bluetang", "groups.chromis-under-min"], "why": "Two tangs together (the app's tang-family rule), a blue tang that will reach 31 cm, and five chromis against a minimum group of six." },
    { "id": "C08", "module": "C", "tank": "g125", "env": { "water": "salt", "tempC": 25, "note": "mixed reef, two years old, refugium" },
      "stock": [ { "id": "yellowtang", "n": 1 }, { "id": "bluetang", "n": 1 }, { "id": "coralbeauty", "n": 1 }, { "id": "ocellaris", "n": 2, "note": "a pair" }, { "id": "chromis", "n": 9 }, { "id": "mandarin", "n": 1 }, { "id": "watchman", "n": 1 }, { "id": "cleanershrimp", "n": 2 }, { "id": "hermit", "n": 20 }, { "id": "turbo", "n": 10 } ],
      "focal": "chromis", "ask": ["verdict", "change", "counts", "confidence"],
      "tests": ["space.reef-125", "space.salt-scale"], "why": "A mature 125 reef at a stocking experienced reefers run. The upper end of the salt scale." },
    { "id": "C09", "module": "C", "tank": "aio20", "env": { "water": "salt", "tempC": 25, "note": "three months old, no refugium" },
      "stock": [ { "id": "mandarin", "n": 1 }, { "id": "ocellaris", "n": 2, "note": "a pair" } ],
      "ask": ["verdict", "change", "confidence"],
      "tests": ["limits.food-not-room", "tankmin.mandarin"], "why": "A mandarin in a young nano: the limit is pods, not room. The app has a maturity and food need for it; this checks the verdict and the reason, not a count." },
    { "id": "C10", "module": "C", "tank": "g29", "env": { "water": "salt", "tempC": 25, "note": "live rock" },
      "stock": [ { "id": "banggai", "n": 5, "note": "unsexed juveniles" }, { "id": "ocellaris", "n": 2, "note": "a pair" } ],
      "ask": ["verdict", "change", "max", "confidence"],
      "max": [ { "species": "banggai", "options": ["0", "1", "2", "3", "5", "7+"] } ],
      "tests": ["groups.territory-banggai"], "why": "The app allows one Banggai pair below 50 gal and a group above it. Five juveniles is how they are sold." },
    { "id": "C11", "module": "C", "tank": "g40b", "env": { "water": "salt", "tempC": 25, "note": "live rock" },
      "stock": [ { "id": "royalgramma", "n": 2, "note": "bought separately" }, { "id": "firefish", "n": 2, "note": "bought separately" }, { "id": "ocellaris", "n": 2, "note": "a pair" } ],
      "ask": ["verdict", "change", "max", "compat", "confidence"],
      "max": [ { "species": "royalgramma", "options": ["0", "1", "2", "3"] }, { "species": "firefish", "options": ["0", "1", "2", "3", "4+"] } ],
      "tests": ["groups.territory-gramma", "groups.firefish-pair"], "why": "Royal grammas: one below 50 gal in the app, two from 50. Firefish: a pair only when bought together." },
    { "id": "C12", "module": "C", "tank": "g20h", "env": { "water": "salt", "tempC": 25, "note": "live rock" },
      "stock": [ { "id": "ocellaris", "n": 3, "note": "bought as juveniles" } ],
      "ask": ["verdict", "change", "max", "confidence"],
      "max": [ { "species": "ocellaris", "options": ["0", "1", "2", "3", "4+"] } ],
      "tests": ["groups.clown-max-2"], "why": "Three clowns: the app caps ocellaris at two (the third is bullied once a pair forms)." },

    { "id": "D01", "module": "D", "tank": "g10", "env": { "water": "none", "note": "dry, warm side 32 C" },
      "stock": [ { "id": "leopardgecko", "n": 1, "note": "adult" } ],
      "ask": ["verdict", "change", "min", "confidence"],
      "min": { "species": "leopardgecko", "sizes": ["10 gal (20 x 10 x 12 in)", "20 gal long (30 x 12 x 12 in)", "40 gal breeder (36 x 18 x 16 in)", "4 x 2 x 2 ft (48 x 24 x 24 in)"] },
      "tests": ["herp.floor-min-leo"], "why": "The app's leopard gecko floor is 4.5 sq ft (36 x 18) at the warning line and 6 recommended. Pet-shop advice still says 10 or 20 gal." },
    { "id": "D02", "module": "D", "tank": "t36x18x16", "env": { "water": "none", "note": "dry, warm side 32 C" },
      "stock": [ { "id": "leopardgecko", "n": 2, "note": "juveniles about 5 in, sexes unknown" } ],
      "ask": ["verdict", "change", "compat", "max", "confidence"],
      "max": [ { "species": "leopardgecko", "options": ["1", "2", "3", "4+"], "label": "if they all turn out female" } ],
      "tests": ["herp.cohab-sex-rule", "herp.each-extra"], "why": "Two leos of unknown sex: two males fight, a male pesters a female. The app adds 3 sq ft per extra animal and caps at 2." },
    { "id": "D03", "module": "D", "tank": "t12x12x18", "env": { "water": "none", "note": "humid, planted" },
      "stock": [ { "id": "crestedgecko", "n": 1, "note": "adult" } ],
      "ask": ["verdict", "change", "min", "confidence"],
      "min": { "species": "crestedgecko", "sizes": ["12 x 12 x 18 in", "18 x 18 x 24 in", "18 x 18 x 36 in", "24 x 18 x 36 in"] },
      "tests": ["herp.arboreal-min", "herp.height"], "why": "An arboreal gecko in the small kit terrarium. The app wants 18 x 18 and 24 in tall at the line, 36 in recommended." },
    { "id": "D04", "module": "D", "tank": "t18x18x24", "env": { "water": "none", "note": "humid, planted" },
      "stock": [ { "id": "crestedgecko", "n": 1, "note": "adult" }, { "id": "greenanole", "n": 1, "sex": "m", "note": "adult" } ],
      "ask": ["verdict", "change", "compat", "confidence"],
      "tests": ["herp.cross-species"], "why": "Two climbers that want similar humidity. The app keeps every herp species-only; is this pair an exception keepers would allow?" },
    { "id": "D05", "module": "D", "tank": "t18x18x24", "env": { "water": "none", "note": "humid, planted" },
      "stock": [ { "id": "crestedgecko", "n": 2, "sex": [1, 1], "note": "adults" } ],
      "ask": ["verdict", "change", "max", "compat", "confidence"],
      "max": [ { "species": "crestedgecko", "options": ["1", "2", "3", "4+"] } ],
      "tests": ["herp.mixed-pair", "herp.each-extra"], "why": "A male and a female crested gecko: breeding and stress. The app wants 2.25 sq ft per extra gecko (a 36 x 18 floor for two)." },
    { "id": "D06", "module": "D", "tank": "t36x18x16", "env": { "water": "none", "note": "warm side 32 C, hides both ends" },
      "stock": [ { "id": "ballpython", "n": 1, "note": "adult female, about 4.5 ft" } ],
      "ask": ["verdict", "change", "min", "confidence"],
      "min": { "species": "ballpython", "sizes": ["40 gal breeder (36 x 18 x 16 in)", "4 x 2 x 1 ft (48 x 24 x 12 in)", "4 x 2 x 2 ft (48 x 24 x 24 in)", "6 x 2 x 2 ft (72 x 24 x 24 in)"] },
      "tests": ["herp.floor-min-bp", "herp.height-bp"], "why": "The most argued enclosure in the reptile hobby. The app's line is 48 x 24 in and 24 in tall; older advice says a 40 breeder." },
    { "id": "D07", "module": "D", "tank": "t18x18x24", "env": { "water": "none", "note": "bioactive, 80 % humidity" },
      "stock": [ { "id": "dartfrog", "n": 3, "sex": [1, 2], "note": "adults" } ],
      "ask": ["verdict", "change", "max", "compat", "confidence"],
      "max": [ { "species": "dartfrog", "options": ["1", "2", "3", "4", "5+"] } ],
      "tests": ["herp.dartfrog-group", "herp.female-aggression"], "why": "Dyeing dart frogs: the app allows up to 3 and warns about two adult females. Experts split on trios." },
    { "id": "D08", "module": "D", "tank": "t18x18x24", "env": { "water": "none", "note": "humid, planted" },
      "stock": [ { "id": "treefrog", "n": 2, "note": "adults, same size" }, { "id": "dartfrog", "n": 2, "note": "adults" } ],
      "ask": ["verdict", "change", "compat", "confidence"],
      "tests": ["herp.prey-amphibian"], "why": "A White's tree frog eats amphibians up to 50 mm in the app; a dart frog is 45 mm. A predation gate on land." },
    { "id": "D09", "module": "D", "tank": "t18x18x24", "env": { "water": "none", "note": "humid, branches" },
      "stock": [ { "id": "treefrog", "n": 3, "note": "adults, same size" } ],
      "ask": ["verdict", "change", "max", "min", "confidence"],
      "max": [ { "species": "treefrog", "options": ["1", "2", "3", "4", "5+"] } ],
      "min": { "species": "treefrog", "sizes": ["18 x 18 x 24 in", "24 x 18 x 24 in", "36 x 18 x 18 in", "36 x 18 x 36 in"], "label": "for these three" },
      "tests": ["herp.treefrog-each-extra", "herp.height"], "why": "The app gives a White's 2.25 sq ft plus 0.75 each and 24 in of height; sources say a trio wants 36 in." },
    { "id": "D10", "module": "D", "tank": "p20l", "env": { "water": "half", "tempC": 22, "note": "half land, water 4 in deep, tight lid" },
      "stock": [ { "id": "firetoad", "n": 4 }, { "id": "whitecloud", "n": 6 } ],
      "ask": ["verdict", "change", "compat", "max", "confidence"],
      "max": [ { "species": "firetoad", "options": ["1", "2", "3", "4", "6", "8+"] } ],
      "tests": ["herp.toad-group", "herp.toad-with-fish", "gap.toxins"], "why": "Fire-bellied toads with fish in a paludarium: the app has no fish rule for toads and no toxin rule at all. Toad counts test the shoreline figures (2-5 in 10-15 gal)." },
    { "id": "D11", "module": "D", "tank": "g20l", "env": { "water": "fresh", "tempC": 18, "note": "water 8 in deep, a floating land spot, unheated" },
      "stock": [ { "id": "firenewt", "n": 4 }, { "id": "cherryshrimp", "n": 10 }, { "id": "nerite", "n": 2 } ],
      "ask": ["verdict", "change", "compat", "max", "confidence"],
      "max": [ { "species": "firenewt", "options": ["1", "2", "3", "4", "6", "8+"] } ],
      "tests": ["herp.newt-with-shrimp", "herp.newt-group", "compat.temperature-cool"], "why": "Newts with shrimp is the one sourced herp-invert pairing. Newts want 16-22 C, shrimp 18-25; four newts is the app's figure for a 20 long." },
    { "id": "D12", "module": "D", "tank": "g5", "env": { "water": "fresh", "tempC": 25 },
      "stock": [ { "id": "adf", "n": 3 }, { "id": "betta", "n": 1, "sex": "m" } ],
      "ask": ["verdict", "change", "compat", "max", "confidence"],
      "max": [ { "species": "adf", "options": ["0", "1", "2", "3", "4", "6+"] } ],
      "tests": ["herp.adf-with-betta", "herp.adf-min"], "why": "Dwarf frogs with a betta in a 5: a pairing shops suggest and care sheets reject. The app's ADF minimum is 5 gal for one or two." },
    { "id": "D13", "module": "D", "tank": "g10", "env": { "water": "fresh", "tempC": 17, "note": "unheated, cool room" },
      "stock": [ { "id": "axolotl", "n": 1, "note": "adult, about 25 cm" } ],
      "ask": ["verdict", "change", "min", "confidence"],
      "min": { "species": "axolotl", "sizes": ["10 gal (20 x 10 x 12 in)", "20 gal long (30 x 12 x 12 in)", "29 gal (30 x 12 x 18 in)", "40 gal breeder (36 x 18 x 16 in)"] },
      "tests": ["herp.axolotl-min"], "why": "The app's axolotl line is an 18 in long tank, recommended 35 x 18. A 10 gal is the common first mistake." },
    { "id": "D14", "module": "D", "tank": "g20l", "env": { "water": "fresh", "tempC": 17, "note": "unheated, cool room" },
      "stock": [ { "id": "axolotl", "n": 2, "note": "adults, same size" }, { "id": "whitecloud", "n": 6 } ],
      "ask": ["verdict", "change", "compat", "max", "confidence"],
      "max": [ { "species": "axolotl", "options": ["0", "1", "2", "3"] } ],
      "tests": ["herp.axolotl-pair", "herp.axolotl-with-fish"], "why": "Two axolotls in a 20 long (the app adds 1.25 sq ft each) and fish with them (the axolotl eats fish to 80 mm; fish nip gills)." },
    { "id": "D15", "module": "D", "tank": "t18x18x24", "env": { "water": "none", "note": "basking spot 33 C, UVB, misted plants" },
      "stock": [ { "id": "greenanole", "n": 4, "sex": [1, 3], "note": "adults" } ],
